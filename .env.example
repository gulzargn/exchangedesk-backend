# Server Port
PORT=3000

# PostgreSQL Connection String
# If PostgreSQL is running locally or in Docker, specify your connection URI here.
# If left empty or unreachable, ExchangeDesk will automatically fall back to the embedded in-memory PostgreSQL engine.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/exchangedesk

# Business Rules Configuration
MIN_WALLET_BALANCE_TO_BID=3000
MIN_BID_INCREMENT=500
HANDOVER_PLATFORM_FEE=500
DEFAULT_AUCTION_DURATION_MINUTES=10
